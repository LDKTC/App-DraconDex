{
  "$meta": {
    "source": "style.css",
    "app": "DraconDex",
    "version": "2.5.2",
    "extracted": "tokens-only (no component library — vanilla-JS Electron app)",
    "defaultTheme": "midnight",
    "note": "Color roles are theme-scoped. Non-color tokens (radius/layout/motion) are theme-independent and defined once on :root."
  },
  "color": {
    "$description": "Semantic color roles. :root defaults equal the 'midnight' theme; 'daylight' and 'moonlight' override per body[data-theme].",
    "themes": {
      "midnight": {
        "bg": "#0f0f13",
        "surface": "#18181f",
        "raised": "#22222d",
        "hover": "#2a2a38",
        "border": "#2e2e3f",
        "text-1": "#e8e8f0",
        "text-2": "#9090a8",
        "text-3": "#5a5a72",
        "accent": "#6366f1",
        "accent-hover": "#818cf8",
        "danger": "#ef4444",
        "success": "#22c55e"
      },
      "daylight": {
        "bg": "#f4f6fb",
        "surface": "#ffffff",
        "raised": "#eef1f7",
        "hover": "#e2e7f0",
        "border": "#ccd3df",
        "text-1": "#172033",
        "text-2": "#596274",
        "text-3": "#8a94a6",
        "accent": "#2563eb",
        "accent-hover": "#3b82f6",
        "danger": "#dc2626",
        "success": "#16a34a"
      },
      "moonlight": {
        "bg": "#101620",
        "surface": "#182231",
        "raised": "#223044",
        "hover": "#2d3b52",
        "border": "#334258",
        "text-1": "#edf4ff",
        "text-2": "#a6b3c7",
        "text-3": "#66758c",
        "accent": "#7c9cff",
        "accent-hover": "#9bb5ff",
        "danger": "#f87171",
        "success": "#34d399"
      }
    },
    "roleMap": {
      "bg": "--bg",
      "surface": "--surface",
      "raised": "--raised",
      "hover": "--hover",
      "border": "--border",
      "text-1": "--t1",
      "text-2": "--t2",
      "text-3": "--t3",
      "accent": "--accent",
      "accent-hover": "--accentH",
      "danger": "--danger",
      "success": "--success"
    }
  },
  "radius": {
    "sm": { "value": "4px", "var": "--rs" },
    "md": { "value": "8px", "var": "--r" },
    "lg": { "value": "12px", "var": "--rl" }
  },
  "layout": {
    "nav": { "value": "56px", "var": "--nav" },
    "sidebar": { "value": "264px", "var": "--sidebar" }
  },
  "motion": {
    "ease": { "value": ".15s ease", "var": "--ease" }
  },
  "scale": {
    "ui": { "value": "1", "var": "--ui-scale", "note": "Multiplied into a transform on .ui-scale-wrap" }
  },
  "typography": {
    "baseSize": "14px",
    "fontFamily": {
      "sans": "'Segoe UI Emoji','Segoe UI Symbol','Segoe UI',system-ui,-apple-system,sans-serif",
      "mono": "'Courier New',monospace"
    }
  },
  "elevation": {
    "$description": "Observed shadow patterns — NOT tokenized as CSS variables in source; listed for reference only.",
    "subtle": "0 1px 3px rgba(0,0,0,.2)",
    "card": "0 4px 12px rgba(0,0,0,.3)",
    "dropdown": "0 6px 20px rgba(0,0,0,.3)",
    "modal": "0 24px 64px rgba(0,0,0,.55)",
    "focusRing": "0 0 0 2px var(--ec, var(--accent))"
  }
}
