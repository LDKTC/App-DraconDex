{
  "name": "@ldktc/dracondex",
  "productName": "DraconDex",
  "version": "4.7.0",
  "description": "Novel data management app",
  "main": "main.js",
  "license": "MIT",
  "author": "LDKTC",
  "repository": {
    "type": "git",
    "url": "https://github.com/LDKTC/App-DraconDex.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.html",
    "main.js",
    "preload.js",
    "preload-plugin.js",
    "database.js",
    "start.js",
    "ensure-electron.js",
    "css/**/*",
    "src/**/*",
    "Image/**/*",
    "vendor/**/*",
    "scripts/**/*"
  ],
  "scripts": {
    "start": "node ./start.js",
    "postinstall": "node ./ensure-electron.js",
    "build:portable": "electron-builder --win dir --publish never && node scripts/finish-portable.mjs",
    "build:exe": "electron-builder --win portable --publish never",
    "build:installer": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "node-sqlite3-wasm": "^0.8.59"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1"
  },
  "build": {
    "appId": "com.dracondex.app",
    "productName": "DraconDex",
    "asar": true,
    "directories": {
      "output": "DraconDexPortable"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "preload-plugin.js",
      "css/**/*",
      "database.js",
      "package.json",
      "src/**/*",
      "Image/**/*",
      "vendor/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "th"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "Image/DraconDex_Icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DraconDex-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DraconDex-Portable-${version}.${ext}"
    }
  }
}
