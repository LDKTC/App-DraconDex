{
  "name": "DraconDex",
  "version": "2.5.5",
  "description": "Novel data management app",
  "main": "main.js",
  "scripts": {
    "start": "node ./start.js",
    "postinstall": "node ./ensure-electron.js",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "node-sqlite3-wasm": "^0.8.59"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dracondex.app",
    "productName": "DraconDex",
    "asar": true,
    "directories": {
      "output": "DraconDexPortable"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "style.css",
      "database.js",
      "package.json",
      "src/**/*",
      "Image/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
